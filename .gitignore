# ============================================================
# TICKET MANAGEMENT SYSTEM — .gitignore
# Base: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
# ============================================================

# -----------------------------------------------
# CRITICAL: Environment & Secrets
# NEVER commit these — contain passwords, API keys
# -----------------------------------------------
.env
.env.local
.env.production
.env.staging
!.env.example

# User Secrets (dotnet user-secrets)
secrets.json
**/secrets.json

# Certificates
*.pfx
*.pem
*.cer

# -----------------------------------------------
# .NET Build Artifacts
# -----------------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# -----------------------------------------------
# Application Logs (generated at runtime)
# -----------------------------------------------
Logs/
*.log
*.tlog

# -----------------------------------------------
# Visual Studio
# -----------------------------------------------
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vs/
Generated\ Files/
*.code-workspace

# -----------------------------------------------
# VS Code
# -----------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# -----------------------------------------------
# JetBrains Rider
# -----------------------------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.sln.iml
.idea/

# -----------------------------------------------
# NuGet
# -----------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# -----------------------------------------------
# Test Results & Coverage
# -----------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml
*.VisualState.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# -----------------------------------------------
# SQL Server local files
# -----------------------------------------------
*.mdf
*.ldf
*.ndf

# -----------------------------------------------
# Docker
# -----------------------------------------------
# Don't ignore docker-compose.yml — commit that
# But ignore override files with local secrets
docker-compose.override.yml

# -----------------------------------------------
# Node.js (for Angular frontend)
# -----------------------------------------------
node_modules/
.npm
.pnpm-store/

# Angular build output
frontend/dist/
frontend/.angular/

# -----------------------------------------------
# OS generated files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------
# Temporary & misc files
# -----------------------------------------------
*.tmp
*.tmp_proj
*~
~$*
*.bak
*.swp
*.cache
!?*.[Cc]ache/
*.binlog
mono_crash.*

# -----------------------------------------------
# Visual Studio build artifacts (compiled files)
# -----------------------------------------------
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# -----------------------------------------------
# Azure / Publish
# -----------------------------------------------
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/
csx/
*.build.csdef
ScaffoldingReadMe.txt