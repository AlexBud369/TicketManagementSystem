ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

SQL_SERVER_PASSWORD=YourStrong@Password123
FRONTEND_URL=http://localhost:4200
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET

ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=TicketManagementDB;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;MultipleActiveResultSets=True

AppSettings__FrontendUrl=http://localhost:4200
AppSettings__MaxImageSizeMb=5
AppSettings__ServiceFeePercentage=0.05

Jwt__Issuer=TicketManagement
Jwt__Audience=TicketManagement
Jwt__SigningKey=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Jwt__RememberMeRefreshTokenDays=30

Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__ServiceRoleKey=YOUR_SERVICE_ROLE_KEY
Supabase__Bucket=ticket-images

Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__WebhookSecret=whsec_REPLACE_ME
Stripe__Currency=usd

Email__Host=smtp.example.com
Email__Port=587
Email__User=your@email
Email__Password=app-password
Email__From=no-reply@tickets.local
Email__UseSsl=true

ADMIN_EMAIL=admin@tickets.local
